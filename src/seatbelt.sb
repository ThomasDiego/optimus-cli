; macOS kernel sandbox for every command. Params: ROOT (project), HOME,
; TMP (per-user temp), NET ("1" when the user approved network), GIT ("1"
; for git tool writes).
(version 1)
(allow default)

; Network: no IP, no unix sockets (docker.sock…). With NET=1, IP and DNS only.
(deny network-outbound (remote ip))
(deny network-outbound (remote unix-socket))
(if (equal? (param "NET") "1")
  (allow network-outbound (remote ip) (literal "/private/var/run/mDNSResponder")))

; Reads: deny by default; stat() stays allowed so path lookups work.
(deny file-read-data)
(allow file-read-data
  (literal "/")
  (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/Library") (subpath "/opt") (subpath "/Applications/Xcode.app")
  (subpath "/private/etc") (subpath "/private/var/db") (subpath "/private/tmp") (subpath "/dev")
  (subpath (param "TMP"))
  (subpath (param "ROOT"))
  (subpath (string-append (param "HOME") "/.cargo"))
  (subpath (string-append (param "HOME") "/.rustup"))
  (subpath (string-append (param "HOME") "/.npm"))
  (subpath (string-append (param "HOME") "/.nvm"))
  (subpath (string-append (param "HOME") "/.bun"))
  (subpath (string-append (param "HOME") "/.deno"))
  (subpath (string-append (param "HOME") "/.pyenv"))
  (subpath (string-append (param "HOME") "/go"))
  (subpath (string-append (param "HOME") "/.local/bin"))
  (subpath (string-append (param "HOME") "/.local/lib"))
  (subpath (string-append (param "HOME") "/Library/pnpm"))
  (subpath (string-append (param "HOME") "/Library/Python"))
  ; Git config and global ignores, read by cargo; credentials stay unreadable.
  (literal (string-append (param "HOME") "/.gitconfig"))
  (subpath (string-append (param "HOME") "/.config/git")))
(deny file-read-data
  (regex #"/\.cargo/credentials(\.toml)?$")
  (regex #"/\.env$")
  (regex #"/\.env\.[^/]*$"))
(allow file-read-data (regex #"/\.env\.(example|sample|template)$"))

; Writes: project and temp. Package caches only when downloading (NET=1),
; so offline commands cannot poison caches shared with other projects.
(deny file-write*)
(allow file-write* (subpath (param "ROOT")) (subpath (param "TMP")) (subpath "/private/tmp") (subpath "/dev"))
(if (equal? (param "NET") "1")
  (allow file-write*
    (subpath (string-append (param "HOME") "/.cargo/registry"))
    (subpath (string-append (param "HOME") "/.cargo/git"))
    (subpath (string-append (param "HOME") "/.npm"))
    (subpath (string-append (param "HOME") "/Library/Caches"))))
(deny file-write* (subpath (string-append (param "ROOT") "/.git")))
; Only the git tool (fixed subcommands, hooks disabled) may write .git.
(if (equal? (param "GIT") "1")
  (allow file-write* (subpath (string-append (param "ROOT") "/.git"))))
